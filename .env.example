# Local model is the default. A paid API is not required.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0

# Optional cloud model. Set AI_PROVIDER=gemini and fill the key to use it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resource limits. Leave unset to keep the defaults.
CRAWL_CONCURRENCY=10
CRAWL_STUCK_MINUTES=30
MAX_UPLOAD_BYTES=25000000
BACKUP_KEEP=7

# REQUIRED in production mode: a real contact / policy page placed in the crawler User-Agent. No default.
# Example: https://example.com/crawler or mailto:you@company.example
CRAWLER_CONTACT_URL=

# production (default) needs a real contact above. dev / test: local test servers only (the test contact test@example.invalid is allowed, and only for local hosts).
CRAWLER_MODE=production
# robots.txt answering 5xx / 429: disallow (default, RFC 9309; pending supervisor confirmation) or allow
ROBOTS_5XX_POLICY=disallow
# Optional PostgreSQL (pending supervisor confirmation). Without it the local SQLite file is used. Never commit the password.
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/websites
# Raw HTML is not stored by default (days to keep gzip copies; 0 = off)
RAW_HTML_RETENTION_DAYS=0
